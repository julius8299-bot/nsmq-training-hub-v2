{
  "name": "nsmq-training-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:ensure": "tsx scripts/prepare-sqlite.ts && prisma db push --skip-generate && tsx scripts/ensure-database.ts && tsx scripts/import-catalog.ts && tsx scripts/import-elements.ts",
    "auth:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test:foundation": "tsx scripts/check-v3-foundation.ts",
    "test:v3-routes": "tsx scripts/check-v3-routes.ts",
    "test:preservation": "tsx scripts/check-bank-preservation.ts",
    "typecheck": "tsc --noEmit",
    "db:studio": "prisma studio",
    "test:answers": "tsx scripts/check-answer-regression.ts",
    "test:question-bank": "tsx scripts/check-question-bank-regression.ts",
    "test:routes": "tsx scripts/check-app-routes.ts",
    "test:upgrade": "tsx scripts/check-training-upgrade.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "db:import-catalog": "tsx scripts/import-catalog.ts",
    "db:import-elements": "tsx scripts/import-elements.ts",
    "db:copy-local": "tsx scripts/copy-local-records.ts",
    "test:elements": "tsx scripts/check-elements.ts",
    "test:hosted-import": "tsx scripts/check-hosted-import.ts",
    "test:text": "tsx scripts/check-text-format.ts && tsx scripts/check-speech.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@prisma/adapter-libsql": "6.19.3",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "papaparse": "^5.4.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "tsx": {
      "esbuild": "0.28.2"
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}
