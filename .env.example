# Local development: the SQLite file in prisma/ (your existing database).
DATABASE_URL="file:./dev.db"
APP_URL="http://localhost:3000"

# Hosted (Vercel + Neon): the Neon integration adds these automatically. Do not commit real values.
# POSTGRES_PRISMA_URL      pooled connection used by the running site
# POSTGRES_URL_NON_POOLING direct connection used by the build to update tables
# POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# One-time first-admin setup at /setup. Use a long random value; remove it after your admin account exists.
# SETUP_SECRET=""

# Optional: your own domain, if you add one in Vercel (e.g. https://train.ghanatashs.org).
# APP_URL="https://..."
